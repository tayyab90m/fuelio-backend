# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_dashboard?schema=public"
# Separate database for `npm test` - it is reset and reseeded on every run,
# so it must never point at the development database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_dashboard_test?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT secrets — use long random strings in real environments
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes (accepted by @fastify/jwt / ms style strings)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ORIGIN="*"

# Behind a reverse proxy / load balancer? Set true so rate limits see real IPs.
TRUST_PROXY=false
# false -> POST /auth/register returns 403 (admins can still create users)
REGISTRATION_ENABLED=true
# Requests per minute per IP: whole API, and login/register/refresh
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
