# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_dashboard?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT secrets — use long random strings in real environments
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes (accepted by @fastify/jwt / ms style strings)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ORIGIN="*"
